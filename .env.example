# ========================
# PhonePe Payment Gateway
# ========================
# Set SANDBOX for UAT testing or PRODUCTION for live ₹3,000 payments:
PHONEPE_ENV=SANDBOX

# Option A — PhonePe Standard Checkout V2 (OAuth Client Credentials from PhonePe Business Dashboard):
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1

# Option B — PhonePe PG V1 (Merchant ID + Salt Key, if your dashboard gives Salt Key):
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1

# Optional explicit site URL when deployed behind proxy (e.g. https://limwhites.com):
PUBLIC_SITE_URL=

# ========================
# Real Confirmation SMS (+91 Mobile)
# ========================
# Option 1 (India): Fast2SMS API Key
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q

# Option 2: Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Option 3: MSG91 Flow API
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ========================
# Owner Desk & Google Sheets Sync
# ========================
VITE_OWNER_PIN=LIMWHITES2026
SUBMISSION_WEBHOOK_URL=
